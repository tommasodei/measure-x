          "queryText": "[\n  {\n    \"$match\": {\n        \"$expr\": {\n            \"$and\": [\n              {\n                \"$gt\": [\"$start_time\", {\"$divide\": [{ \"$toLong\": \"$__from\" },1000]}]\n              },\n              {  \n                \"$lt\": [\"$start_time\", {\"$divide\": [{ \"$toLong\": \"$__to\" },1000]}]\n              },\n              {\n                \"$gt\": [\"$stop_time\", {\"$divide\": [{ \"$toLong\": \"$__from\" },1000]}]\n              },\n              {  \n                \"$lt\": [\"$stop_time\", {\"$divide\": [{ \"$toLong\": \"$__to\" },1000]}]\n              },\n              {\n                \"$lt\": [\"$start_time\", \"$stop_time\"]\n              },\n              {  \n                \"$eq\": [\"$type\", \"iperf\"]\n              }\n            ]\n        }\n    }\n  },\n  {\n    \"$lookup\": {\n        \"from\": \"results\",\n        \"localField\": \"results\",\n        \"foreignField\": \"_id\",\n        \"as\": \"resultsData\"\n    }\n  },\n  {\n    \"$unwind\": \"$resultsData\"\n  },\n  {\n    \"$project\": {\n        \"_id\": 0,\n        \"time\": {\"$toDate\": {\"$multiply\": [\"$start_time\", 1000]}},\n        \"avg_speed\": \"$resultsData.avg_speed\"\n    }\n  },\n  {\n    \"$sort\": {\"time\": 1}\n  }\n]"
        }
